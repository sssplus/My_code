# PodcastForge backend — copy to .env (or set these in your host's dashboard)

# REQUIRED in production. A long random string. Generate with:  openssl rand -hex 32
# The encryption key for stored API keys is derived from this, and sessions are
# signed with it — if it changes, all stored keys become unreadable and everyone
# is logged out. Set it once and keep it stable.
PF_SECRET=

# Postgres connection string (Neon / Supabase / RDS ...). When set, the app uses
# Postgres; when unset, it falls back to a local JSON file (data/db.json).
# Example (Neon):  postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Set to "disable" only for a self-hosted Postgres without TLS. Leave blank for
# managed providers (they require TLS).
PGSSL=

# Port to listen on (most hosts set this automatically).
PORT=3000

# Set to "production" on your host. With this set, the server refuses to boot
# unless PF_SECRET is set.
NODE_ENV=

# Optional: enable real Razorpay billing. When set, /api/billing/checkout
# requires a verified payment signature before granting a paid plan.
RAZORPAY_KEY_SECRET=

# ---- Social login (optional) ----
# APP_URL is REQUIRED for OAuth: it's the canonical https origin of your app and
# is used to build the OAuth redirect URI and the post-login redirect. OAuth is
# disabled until APP_URL is set (the redirect origin is never taken from request
# headers, to prevent token-stealing host spoofing).
# Example:  https://app.yourdomain.com
APP_URL=

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI:  ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers).
# Authorization callback URL:  ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
